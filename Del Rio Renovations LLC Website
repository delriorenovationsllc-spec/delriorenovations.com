    };

    function addBotMessage(text, showOptions = false) {
        const msgDiv = document.createElement('div');
        msgDiv.className = 'chat-msg bot';

        let html = `<p>${text.replace(/\n/g, '<br>')}</p>`;

        if (showOptions) {
            html += `<div class="chat-options">
                <button class="chat-option" data-action="consultation">Schedule a consultation</button>
                <button class="chat-option" data-action="call">Talk to someone now</button>
            </div>`;
        }

        msgDiv.innerHTML = html;
        chatMessages.appendChild(msgDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Rebind new option buttons
        msgDiv.querySelectorAll('.chat-option').forEach(btn => {
            btn.addEventListener('click', handleOptionClick);
        });
    }

    function addUserMessage(text) {
        const msgDiv = document.createElement('div');
        msgDiv.className = 'chat-msg user';
        msgDiv.innerHTML = `<p>${text}</p>`;
        chatMessages.appendChild(msgDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function handleOptionClick(e) {
        const action = e.target.getAttribute('data-action');
        const text = e.target.textContent;
        addUserMessage(text);

        setTimeout(() => {
            if (botResponses[action]) {
                const showFollowup = !['consultation', 'call'].includes(action);
                addBotMessage(botResponses[action], showFollowup);
            }
        }, 500);
    }

    // Bind initial option buttons
    document.querySelectorAll('.chat-option').forEach(btn => {
        btn.addEventListener('click', handleOptionClick);
    });

    // Free text input
    function handleChatInput() {
        const text = chatInput.value.trim();
        if (!text) return;

        addUserMessage(text);
        chatInput.value = '';

        setTimeout(() => {
            const lower = text.toLowerCase();

            if (lower.includes('service') || lower.includes('what do you') || lower.includes('offer')) {
                addBotMessage(botResponses.services, true);
            } else if (lower.includes('price') || lower.includes('cost') || lower.includes('estimate') || lower.includes('how much')) {
                addBotMessage(botResponses.pricing, true);
            } else if (lower.includes('how long') || lower.includes('timeline') || lower.includes('time') || lower.includes('duration')) {
                addBotMessage(botResponses.timeline, true);
            } else if (lower.includes('financ') || lower.includes('payment') || lower.includes('pay') || lower.includes('zelle')) {
                addBotMessage(botResponses.financing, true);
            } else if (lower.includes('area') || lower.includes('where') || lower.includes('location') || lower.includes('denver') || lower.includes('aurora') || lower.includes('serve')) {
                addBotMessage(botResponses.area, true);
            } else if (lower.includes('consult') || lower.includes('schedule') || lower.includes('appointment') || lower.includes('book')) {
                addBotMessage(botResponses.consultation);
            } else if (lower.includes('call') || lower.includes('phone') || lower.includes('talk') || lower.includes('speak')) {
                addBotMessage(botResponses.call);
            } else if (lower.includes('permit')) {
                addBotMessage(botResponses.permits, true);
            } else if (lower.includes('sub') || lower.includes('contractor') || lower.includes('worker') || lower.includes('crew')) {
                addBotMessage(botResponses.subcontractors, true);
            } else if (lower.includes('bathroom') || lower.includes('bath') || lower.includes('shower') || lower.includes('tub')) {
                addBotMessage(`🛁 Bathrooms are our specialty! We do full custom remodels including:\n\n• Curbless shower pans\n• Vanity installs\n• Full custom baths\n• Acrylic & groutless tile installs\n• Walk-in showers with glass doors\n• Freestanding tub installs\n\nWant to schedule a consultation to discuss your bathroom project?`, true);
            } else if (lower.includes('kitchen')) {
                addBotMessage(`🍳 Yes! We do full kitchen renovations — from demo to finish.\n\nWant to schedule a consultation to discuss your kitchen project?`, true);
            } else if (lower.includes('floor')) {
                addBotMessage(`🏠 We install all types of flooring — tile, hardwood, LVP, laminate, and more.\n\nWant to schedule a consultation to discuss your flooring project?`, true);
            } else if (lower.includes('paint')) {
                addBotMessage(`🎨 We offer both interior and exterior painting services with professional prep and quality finishes.\n\nWant to schedule a consultation?`, true);
            } else if (lower.includes('spanish') || lower.includes('español') || lower.includes('habla')) {
                addBotMessage(`🇲🇽 ¡Sí, hablamos Español! Ricardo y el equipo hablan inglés y español.\n\n📞 Llámenos: <a href="tel:7208768875" style="color: #c8a84e; font-weight: bold;">(720) 876-8875</a>\n\n¡Estamos aquí para ayudarle con su proyecto!`, true);
            } else if (lower.includes('hello') || lower.includes('hi') || lower.includes('hey') || lower.includes('hola')) {
                addBotMessage(`👋 Hey! Thanks for reaching out to Del Rio Renovations. How can I help you today?\n\nI can answer questions about our services, pricing, timelines, or help you schedule a consultation!`, false);
            } else {
                addBotMessage(botResponses.default);
            }
        }, 600);
    }

    if (chatSend) {
        chatSend.addEventListener('click', handleChatInput);
    }

    if (chatInput) {
        chatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') handleChatInput();
        });
