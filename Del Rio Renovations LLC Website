document.addEventListener('DOMContentLoaded', function () {

    // ---- NAVBAR SCROLL ----
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    });

    // ---- MOBILE NAV TOGGLE ----
    const navToggle = document.getElementById('navToggle');
    const navMenu = document.getElementById('navMenu');

    if (navToggle) {
        navToggle.addEventListener('click', () => {
            navToggle.classList.toggle('active');
            navMenu.classList.toggle('active');
        });

        // Close menu on link click
        navMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                navToggle.classList.remove('active');
                navMenu.classList.remove('active');
            });
        });
    }

    // ---- STAT COUNTER ANIMATION ----
    const statNumbers = document.querySelectorAll('.stat-number[data-target]');

    const animateCount = (el) => {
        const target = parseInt(el.getAttribute('data-target'));
        const duration = 2000;
        const step = target / (duration / 16);
        let current = 0;

        const update = () => {
            current += step;
            if (current >= target) {
                el.textContent = target;
            } else {
                el.textContent = Math.floor(current);
                requestAnimationFrame(update);
            }
        };
        update();
    };

    const statObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                animateCount(entry.target);
                statObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });

    statNumbers.forEach(num => statObserver.observe(num));

    // ---- SCROLL REVEAL ANIMATION ----
    const revealElements = document.querySelectorAll(
        '.service-card, .why-card, .testimonial-card, .about-preview-inner, .section-header'
    );

    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    revealElements.forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(30px)';
        el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        revealObserver.observe(el);
    });

    // Add revealed class styles
    const style = document.createElement('style');
    style.textContent = `.revealed { opacity: 1 !important; transform: translateY(0) !important; }`;
    document.head.appendChild(style);

    // ---- BEFORE/AFTER SLIDER ----
    const baRanges = document.querySelectorAll('.ba-range');
    baRanges.forEach(range => {
        range.addEventListener('input', function () {
            const val = this.value;
            const afterImg = this.parentElement.querySelector('.ba-after');
            if (afterImg) {
                afterImg.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
            }
        });
    });

    // ---- LANGUAGE TOGGLE ----
    const langToggle = document.getElementById('langToggle');
    let isSpanish = false;

    const translations = {
        heroH1: {
            en: 'Quality Bathroom Remodels <span class="gold">Built to Last</span>',
            es: 'Remodelaciones de Baños de Calidad <span class="gold">Hechas para Durar</span>'
        },
        heroSub: {
            en: 'Family-owned general contracting with 15+ years of hands-on experience. Serving Aurora, Denver, and all of the Colorado Front Range.',
            es: 'Contratista general familiar con más de 15 años de experiencia. Sirviendo Aurora, Denver y todo el Front Range de Colorado.'
        },
        heroCta: {
            en: 'Schedule a Consultation',
            es: 'Agendar una Consulta'
        },
        heroGallery: {
            en: 'View Our Work',
            es: 'Ver Nuestro Trabajo'
        }
    };

    if (langToggle) {
        langToggle.addEventListener('click', () => {
            isSpanish = !isSpanish;
            langToggle.textContent = isSpanish ? 'EN' : 'ES';
            langToggle.title = isSpanish ? 'Switch to English' : 'Cambiar a Español';

            const heroH1 = document.querySelector('.hero h1');
            const heroSub = document.querySelector('.hero-sub');

            if (heroH1) heroH1.innerHTML = isSpanish ? translations.heroH1.es : translations.heroH1.en;
            if (heroSub) heroSub.textContent = isSpanish ? translations.heroSub.es : translations.heroSub.en;
        });
    }

    // ---- CHATBOT ----
    const chatbotToggle = document.getElementById('chatbotToggle');
    const chatbot = document.getElementById('chatbot');
    const chatbotClose = document.getElementById('chatbotClose');
    const chatMessages = document.getElementById('chatMessages');
    const chatInput = document.getElementById('chatInput');
    const chatSend = document.getElementById('chatSend');

    if (chatbotToggle) {
        chatbotToggle.addEventListener('click', () => {
            chatbot.classList.toggle('active');
            chatbotToggle.style.display = chatbot.classList.contains('active') ? 'none' : 'flex';
        });
    }

    if (chatbotClose) {
        chatbotClose.addEventListener('click', () => {
            chatbot.classList.remove('active');
            chatbotToggle.style.display = 'flex';
        });
    }

    // Chatbot responses
    const botResponses = {
        services: `We offer a full range of renovation services:\n\n🛁 <strong>Bathroom Remodels</strong> — Curbless showers, vanity installs, full custom baths, acrylic & groutless tile\n🍳 <strong>Kitchen Renovations</strong>\n🏠 <strong>Flooring Installs</strong> — All types\n🎨 <strong>Interior & Exterior Painting</strong>\n🔨 <strong>Framing, Drywall & Mud Work</strong>\n🏗️ <strong>General Contracting</strong>\n\nWould you like to schedule a consultation?`,

        pricing: `Before accepting any job, we visit your home to see the scope of work in person and talk to the homeowner.\n\nWe use <strong>up-to-date pricing by the square foot</strong> depending on material and scope of work. <strong>Detailed estimates and invoices are always provided</strong> so we're clear on every part of the project.\n\nWant to schedule a free in-person consultation?`,

        timeline: `Great question! Timeline depends on the size and scope of the project. For example:\n\n⚡ <strong>Bath conversion</strong> — Can be as fast as <strong>2 days</strong> depending on material\n🏠 <strong>Full bathroom remodel</strong> — Typically 1-3 weeks\n\nAfter reviewing the scope of work, we create a <strong>detailed plan and timeline</strong> that is shared with you before we start.\n\nWant to discuss your specific project?`,

        financing: `Yes! If needed, we can work together with a <strong>third-party financing company</strong> to help you get your dream space without clearing your account.\n\nWe also accept <strong>cash, check, and Zelle</strong>.\n\nWant to learn more? Schedule a consultation!`,

        area: `We serve <strong>Aurora, Denver, and anywhere within 100 miles of Aurora!</strong> 🏔️\n\nThat includes Centennial, Lakewood, Thornton, Arvada, Parker, Castle Rock, Colorado Springs, and many more.\n\nAre you in our service area? Let's chat about your project!`,

        consultation: `We'd love to discuss your project! Here's how to get started:\n\n📋 <a href="contact.html" style="color: #c8a84e; font-weight: bold;">Fill out our consultation form →</a>\n\nOr if you prefer:\n📞 <a href="tel:7208768875" style="color: #c8a84e; font-weight: bold;">Call us: (720) 876-8875</a>\n📧 <a href="mailto:delriorenovationsllc@gmail.com" style="color: #c8a84e; font-weight: bold;">Email us</a>\n\n🕐 We're available <strong>Mon–Sat, 7AM – 7PM</strong>\n🇺🇸🇲🇽 Bilingual — English & Spanish`,

        call: `Ready to talk? Give us a call right now!\n\n📞 <a href="tel:7208768875" style="color: #c8a84e; font-weight: bold; font-size: 1.1rem;">(720) 876-8875</a>\n\n🕐 Available <strong>Mon–Sat, 7AM – 7PM</strong>\n🇺🇸🇲🇽 Hablamos Español\n\nRicardo or a team member will be happy to help!`,

        permits: `Unless it is absolutely necessary for the client and/or the scope of work, permits are typically not needed. But if they are, <strong>we can help you with the permit process</strong>.\n\nHave another question?`,

